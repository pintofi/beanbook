# Build outputs and local machine config
/build/
/*/build/
/local.properties

# Generated corpus: deterministic, rebuilt with tools/corpus/generate.py.
# The small cases and the recorded baselines are committed; the 2.5 MB one is not.
/corpus/large/

# Release artefacts, produced by the release workflow
checksums.txt

# Cross-built Android wheels, produced by tools/build-wheels.sh
/wheels/

# Pins for the locally cross-built wheels; regenerated by tools/build-wheels.sh
engine-local/requirements-local.lock

# Scratch directories written by the Google android/skills audits (play-policy-insights
# and friends). Their findings are summarised in docs/pending-verification.md; the raw
# worker JSON is a per-run artefact and is not worth versioning.
.scratch/
.claude/worktrees/

