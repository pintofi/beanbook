<?xml version="1.0" encoding="utf-8"?>
<!--
  Expert edition only.

  `ApkUpdate` commits a PackageInstaller session in MODE_FULL_INSTALL, and Android has
  required REQUEST_INSTALL_PACKAGES for that since API 26. Without it a signed, checksum-
  verified, certificate-matched update fails at the very last step, after every check has
  already passed.

  It must never reach the Play edition: `:verifyPlayFlavorBoundaries` fails the build if this
  permission appears in the play manifest, and Google Play delivers updates for that edition
  (docs/distribution.md 2.1, D3). Declaring it in this source set is what makes that rule
  guard something rather than nothing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
