<?xml version="1.0" encoding="utf-8"?>
<!--
  The balance widget when it has been told to show several accounts (B48), on the same ruled
  paper as the single-figure one (B74).

  A container the renderer fills with one row per account, rather than a collection view: a
  RemoteViews list needs a RemoteViewsService, and a service is background work: the one
  thing the widgets in this app are arranged not to have. `addView` is enough for a handful
  of rows and costs nothing when the home screen redraws.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="@color/widget_rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingLeft="10dp">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_label" />

        <LinearLayout
            android:id="@+id/widget_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/widget_footnote" />
    </LinearLayout>
</LinearLayout>
