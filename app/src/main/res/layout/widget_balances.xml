<?xml version="1.0" encoding="utf-8"?>
<!--
  The balance widget when it has been told to show several accounts (B48): a container the
  renderer fills with one row per account, rather than a collection view, which would need a
  service: the one thing these widgets are arranged not to have.

  The paper and the rule are ImageViews rather than a background drawable so the renderer can
  colour them from the app's appearance settings: wallpaper accent, dark, AMOLED (B92).
  RemoteViews can tint an ImageView on every supported API; a background tint needs API 31.

  RemoteViews rather than Glance: a widget is text and a number, and Glance would be another
  dependency and another rendering model to reason about for no gain here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_rule"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:src="@drawable/widget_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingEnd="12dp"
            android:paddingRight="12dp"
            android:paddingStart="20dp"
            android:paddingLeft="20dp">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@color/widget_label" />

            <LinearLayout
                android:id="@+id/widget_rows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/widget_footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/widget_footnote" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
