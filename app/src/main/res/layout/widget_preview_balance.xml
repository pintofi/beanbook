<?xml version="1.0" encoding="utf-8"?>
<!--
  Preview shown in the widget picker, with figures from the household ledger the site's
  screenshots use (fixtures/site-screenshots/household), so the picker shows what the widget
  does instead of an empty frame. Only a picture: nothing here is read from a real ledger.

  The paper and the rule are ImageViews rather than a background drawable so the renderer can
  colour them from the app's appearance settings: wallpaper accent, dark, AMOLED.
  RemoteViews can tint an ImageView on every supported API; a background tint needs API 31.

  The + in the corner adds an entry. It replaced a widget of its own that did nothing
  else, so adding an entry is one tap from the figures a person already keeps on the screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_paper"
        android:tint="@color/widget_surface"
        tools:ignore="UseAppTint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_rule"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_rule"
            android:tint="@color/widget_rule"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:paddingStart="20dp"
            android:paddingLeft="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:text="Balance · Checking"
                    android:textColor="@color/widget_label" />

                <TextView
                    android:id="@+id/widget_add"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="22sp"
                    android:contentDescription="Add an entry"
                    android:textColor="@color/widget_rule" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingEnd="12dp"
                android:paddingRight="12dp"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="22sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="monospace"
                android:text="6,568.65 EUR"
                android:textColor="@color/widget_value" />

            <!-- The same row the live widget carries, Market value chosen. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingEnd="12dp"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="11sp"
                    android:text="Units"
                    android:textColor="@color/widget_footnote" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="11sp"
                    android:text="At cost"
                    android:textColor="@color/widget_footnote" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="Market value"
                    android:textColor="@color/widget_value" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:paddingRight="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:text="Household · 20 Sep 09:41"
                android:textColor="@color/widget_footnote" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
