<?xml version="1.0" encoding="utf-8"?>
<!--
  One layout for all four widgets. They differ in what they are given, not in how they look,
  and a widget that is a label, a figure and a footnote does not need four descriptions of that.

  The paper and the rule are ImageViews rather than a background drawable so the renderer can
  colour them from the app's appearance settings: wallpaper accent, dark, AMOLED (B92).
  RemoteViews can tint an ImageView on every supported API; a background tint needs API 31.

  RemoteViews rather than Glance: a widget is text and a number, and Glance would be another
  dependency and another rendering model to reason about for no gain here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_rule"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:src="@drawable/widget_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingEnd="12dp"
            android:paddingRight="12dp"
            android:paddingStart="20dp"
            android:paddingLeft="20dp">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@color/widget_label" />

            <TextView
                android:id="@+id/widget_value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="22sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_value" />

            <TextView
                android:id="@+id/widget_footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/widget_footnote" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
