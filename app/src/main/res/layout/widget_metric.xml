<?xml version="1.0" encoding="utf-8"?>
<!--
  One figure: a balance or net worth, with a label and a footnote. The two widgets differ in
  what they are given, not in how they look.

  The paper and the rule are ImageViews rather than a background drawable so the renderer can
  colour them from the app's appearance settings: wallpaper accent, dark, AMOLED.
  RemoteViews can tint an ImageView on every supported API; a background tint needs API 31.

  The + in the corner adds an entry. It replaced a widget of its own that did nothing
  else, so adding an entry is one tap from the figures a person already keeps on the screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_rule"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:paddingStart="20dp"
            android:paddingLeft="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:text=""
                    android:textColor="@color/widget_label" />

                <TextView
                    android:id="@+id/widget_add"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="22sp"
                    android:contentDescription="Add an entry"
                    android:textColor="@color/widget_rule" />
            </LinearLayout>

            <!-- The figure shrinks to the height it has, and the footnote keeps to one line:
                 at 2 x 1 on a Pixel launcher a two-line footnote left the figure no room at all,
                 and the widget showed "Net worth" with no number under it. -->
            <TextView
                android:id="@+id/widget_value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingEnd="12dp"
                android:paddingRight="12dp"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="22sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="@color/widget_value" />

            <!-- Units, At cost, Market value: the same three choices as Home, Journal and Balances,
                 on the widget itself. Selecting one changes this widget only. Hidden by the renderer on
                 a widget too short to hold it. -->
            <LinearLayout
                android:id="@+id/widget_basis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingEnd="12dp"
                android:paddingRight="12dp">

                <TextView
                    android:id="@+id/widget_basis_units"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:text="Units"
                    android:contentDescription="Show units"
                    android:textColor="@color/widget_footnote" />

                <TextView
                    android:id="@+id/widget_basis_cost"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:text="At cost"
                    android:contentDescription="Show at cost"
                    android:textColor="@color/widget_footnote" />

                <TextView
                    android:id="@+id/widget_basis_value"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:text="Market value"
                    android:contentDescription="Show market value"
                    android:textColor="@color/widget_footnote" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:paddingRight="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:text=""
                android:textColor="@color/widget_footnote" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
