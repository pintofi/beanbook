<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's paper: a rounded rectangle, drawn white so the renderer can tint it to whatever
  the app's appearance settings say. A shape has no intrinsic size, so an ImageView draws
  it at the widget's own size with crisp corners rather than stretching a picture of one.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#FFFFFFFF" />
</shape>
