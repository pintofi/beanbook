<?xml version="1.0" encoding="utf-8"?>
<!-- One segment of the Units, At cost, Market value row, in the shape the app's connected buttons
     have: the outer corners round, the corners that meet a neighbour tight. White, so the
     renderer can tint it with the app's colours. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners
        android:topLeftRadius="4dp"
        android:bottomLeftRadius="4dp"
        android:topRightRadius="4dp"
        android:bottomRightRadius="4dp" />
</shape>
