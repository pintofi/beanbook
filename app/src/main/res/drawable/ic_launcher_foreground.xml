<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher mark: three ledger rules with their figures aligned on the right.

  Drawn as a vector rather than shipped as bitmaps, so it costs about a kilobyte instead of
  six PNG densities, and stays sharp on any screen.

  Everything sits inside the inner 72x72 of the 108x108 adaptive viewport (18..90), which is
  the region launchers guarantee not to crop when they mask the icon into a circle, a squircle
  or whatever shape the device prefers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Account rules: long, medium, short — a page of entries. -->
    <path android:fillColor="#FFFFFF" android:pathData="M30,40 h30 a2.5,2.5 0 0 1 0,5 h-30 a2.5,2.5 0 0 1 0,-5 z" />
    <path android:fillColor="#FFFFFF" android:pathData="M30,52 h24 a2.5,2.5 0 0 1 0,5 h-24 a2.5,2.5 0 0 1 0,-5 z" />
    <path android:fillColor="#FFFFFF" android:pathData="M30,64 h30 a2.5,2.5 0 0 1 0,5 h-30 a2.5,2.5 0 0 1 0,-5 z" />

    <!-- The amounts column, right-aligned, as it is everywhere in the app. -->
    <path android:fillColor="#9CF1F0" android:pathData="M68,40 h10 a2.5,2.5 0 0 1 0,5 h-10 a2.5,2.5 0 0 1 0,-5 z" />
    <path android:fillColor="#9CF1F0" android:pathData="M68,52 h10 a2.5,2.5 0 0 1 0,5 h-10 a2.5,2.5 0 0 1 0,-5 z" />

    <!-- The rule under a total, and the total itself. -->
    <path android:fillColor="#9CF1F0" android:pathData="M64,61 h14 v1.6 h-14 z" />
    <path android:fillColor="#9CF1F0" android:pathData="M68,64 h10 a2.5,2.5 0 0 1 0,5 h-10 a2.5,2.5 0 0 1 0,-5 z" />
</vector>
