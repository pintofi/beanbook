<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose: Android must never wake this app on a timer. Widgets
  refresh when the app writes the cache, which is the only moment the figures can change.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_metric"
    android:previewLayout="@layout/widget_preview_networth"
    android:description="@string/widget_preview_networth_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard" />
