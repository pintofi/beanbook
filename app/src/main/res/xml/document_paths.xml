<?xml version="1.0" encoding="utf-8"?>
<!--
  What may be shared out of the app.

  This grants `projects/`, not a project's documents directory. FileProvider paths cannot
  express `projects/*/documents`, so the narrower rule lives at the one call site that mints
  URIs: `shareDocument` refuses anything outside `<project>/documents/`. Said plainly because
  the previous comment here claimed only the documents directory was exposed, which was not
  true of this file and made the boundary look stronger than it was.

  The write journal, snapshots and drafts are siblings of `projects/`,
  not children, so they are outside this grant (docs/threat-model.md).
-->
<paths>
    <files-path name="project-documents" path="projects/" />
    <!--
      The diagnostic report, and only it (B62). One file in one cache subdirectory, written
      when the user asks to share it: the log is theirs to hand over, and this is how it
      reaches another app without the app itself sending anything anywhere.
    -->
    <cache-path name="diagnostics" path="diagnostics/" />
</paths>
