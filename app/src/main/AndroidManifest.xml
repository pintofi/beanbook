<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Receipt capture (M8). Optional hardware: a tablet without a camera still runs the
         whole app, so this must not narrow the device list on Play. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Finishing what the user started after they leave the app (B93): a plugin install or a
      save runs under a short foreground service with a notification, and a partial wake lock
      with a timeout keeps it going with the screen off. See work/KeepWorking.kt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Sharing Reports on Wi-Fi (B93): off until the user turns it on. The network state is
      read to find this device's own Wi-Fi address; the special-use foreground service keeps
      the share alive, with a notification naming the address, only while it is on.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".BeancountApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beancount">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sharing a receipt hands out a temporary content:// URI for that one file. The
             app's own storage is never exposed as a path, and the allowlist in
             document_paths.xml covers project documents only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.documents"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/document_paths" />
        </provider>

        <!--
          Home-screen widgets. exported="false": nothing outside this app has any reason to
          broadcast an update to them, and the figures they carry are somebody's finances.
          Android delivers APPWIDGET_UPDATE to a non-exported receiver perfectly well.
        -->
        <!--
          Exported, because a launcher in another process is what starts a widget's
          configuration screen; there is no way to offer one otherwise. It is the second
          exported component this app has, after the launcher activity (B34), so the
          app-widget id it is handed is validated against our own provider before anything
          is written; the activity says how.

          No launcher icon and no MAIN/LAUNCHER filter: it is reachable only through the
          widget placement flow, not from the app drawer.
        -->
        <activity
            android:name=".widget.BalanceWidgetConfigureActivity"
            android:exported="true"
            android:label="Which balance?"
            android:theme="@style/Theme.Beancount">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.BalanceWidget"
            android:label="Account balances"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>

        <receiver
            android:name=".widget.NetWorthWidget"
            android:label="Net worth"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_networth_info" />
        </receiver>

        <service
            android:name=".sharing.SharingService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves the user's own ledger reports to their own browsers on the local network, behind a sign-in, only while the user has turned sharing on; stopped from the notification or the app." />
        </service>

        <service
            android:name=".work.WorkService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
          Supplies the rows of the multi-account balance widget (B93), so the list scrolls.
          Bound only by the launcher, with this app's own BIND_REMOTEVIEWS permission, and it
          reads the widget cache and nothing else: no engine, no network.
        -->
        <service
            android:name=".widget.WidgetRowsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>
</manifest>
